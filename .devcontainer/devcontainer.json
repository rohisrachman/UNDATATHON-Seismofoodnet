{
  "name": "Seismofoodnet",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {"openFiles": ["README.md", "App.py"]},
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "postAttachCommand": {"server": "python -m streamlit run App.py"},
  "portsAttributes": {"8501": {"label": "Seismofoodnet", "onAutoForward": "openPreview"}},
  "forwardPorts": [8501]
}
